# Copy to .env (read by `docker compose` and by the API). Every key is optional:
# a missing key turns the matching feature off, it never crashes the API.

# --- Core ---
VAULT_ROOT=./vault                  # Obsidian vault used as the database (absolute path recommended)
PUBLIC_URL=http://localhost:4321    # where the front is served (notification links, OAuth redirect default)
TIME_ZONE=Europe/Brussels           # Google Calendar pushes, morning brief schedule
TZ=Europe/Brussels                  # process time zone (date folders, "today")
OFFLINE=0                           # 1 = no outbound HTTP at all (weather, posters)
CORS_ORIGINS=http://localhost:4321  # only needed when the front runs on another origin

# --- Weather (Open-Meteo, no key) ---
WEATHER_PLACE=Luxembourg
WEATHER_LAT=49.6116
WEATHER_LON=6.1319

# --- Google Calendar two-way sync (OAuth web client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4321/api/google/callback

# --- AI agent + morning brief (Gemini API) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENT_OWNER_NAME=

# --- Local LLM hosts (page IA.) ---
AI_PC_STATUS_URL=                   # e.g. http://desktop.lan:8097 (status service)
AI_PC_LLM_URL=                      # e.g. http://desktop.lan:8080 (llama.cpp router, OpenAI API)
AI_PC_KEY=
AI_PC_BIG_MODEL=                    # model that needs the desktop's "AI mode" before loading
AI_SERVER_STATUS_URL=
AI_SERVER_LLM_URL=
AI_SERVER_KEY=

# --- Media posters and metadata (TMDB) ---
TMDB_API_KEY=
TMDB_READ_TOKEN=

# --- Push notifications (ntfy) ---
NTFY_URL=                           # e.g. https://ntfy.sh or your own server
NTFY_TOPIC=
NTFY_AUTH=                          # e.g. "Bearer tk_xxx"

# --- STACK page ---
HEALTHCHECK_SERVICES=               # "Gitea=https://git.example.com,Nextcloud=https://cloud.example.com"
CONTAINER_UI_URL=                   # deep link base for containers (Portainer etc.)
DOCKER_SOCKET=/var/run/docker.sock  # "off" to hide the container list

# --- Front (build time) ---
PUBLIC_HUB_LINKS=                   # "GITEA=https://git.example.com,NEXTCLOUD=https://cloud.example.com"
