---
import Base from '../layouts/Base.astro';
import HubWidgets from '../components/islands/HubWidgets.tsx';
import WeatherWidget from '../components/islands/WeatherWidget.tsx';
import HubAgents from '../components/islands/HubAgents.tsx';

// Lanceur de services : PUBLIC_HUB_LINKS="NEXTCLOUD=https://cloud.example.com,GITEA=https://git.example.com" au build.
const DEFAULT_LINKS = 'OBSIDIAN=obsidian://open,API=/api/health,OPEN-METEO=https://open-meteo.com,TMDB=https://www.themoviedb.org,NTFY=https://ntfy.sh';
const apps = (import.meta.env.PUBLIC_HUB_LINKS || DEFAULT_LINKS).split(',').map((pair: string) => {
  const i = pair.indexOf('=');
  return { label: pair.slice(0, i).trim().toUpperCase(), url: pair.slice(i + 1).trim() };
}).filter((a: { label: string; url: string }) => a.label && a.url);

const today = new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).toUpperCase();
---
<Base title="Hub" current="HUB">
  <div class="h-full flex flex-col overflow-y-auto lg:overflow-hidden">
    <header class="px-4 md:px-6 pt-3 pb-2 brutal-border-bottom flex flex-wrap items-end justify-between gap-x-4 shrink-0 anim-slide-up">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-fg-muted)]">huburton/os</p>
        <h1 class="font-display text-[clamp(64px,8vw,112px)] mt-1">HUB.</h1>
      </div>
      <p class="font-mono text-[10px] uppercase tracking-wider text-[var(--color-fg-muted)] pb-2" data-today>{today}</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-4 p-4 lg:flex-1 lg:min-h-0 lg:overflow-hidden">
      <!-- COLONNE GAUCHE : services + widgets -->
      <div class="flex flex-col gap-3 min-w-0 lg:min-h-0 lg:overflow-hidden">
        <section class="shrink-0">
          <div class="flex items-baseline gap-3 mb-2">
            <h2 class="font-section">→ SERVICES</h2>
            <span class="h-px bg-[var(--color-border-soft)] flex-1"></span>
            <span class="font-mono text-[9px] uppercase tracking-wider text-[var(--color-fg-muted)]">{apps.length} ENDPOINTS</span>
          </div>
          <div class="grid grid-cols-5 md:grid-cols-10 gap-2">
            {apps.map((app, i) => (
              <a href={app.url} target="_blank" rel="noopener" class="brutal-border bg-[var(--color-bg-paper)] hover-paper lift px-1 py-2 flex flex-col items-center justify-center text-center anim-slide-up" style={`animation-delay: ${i * 30}ms`}>
                <span class="w-6 h-6 mb-1 grid place-items-center font-display text-[20px] leading-none" aria-hidden="true">{app.label.slice(0, 1)}</span>
                <span class="font-mono text-[9px] font-bold uppercase tracking-wider truncate w-full">{app.label}</span>
              </a>
            ))}
          </div>
        </section>

        <div class="lg:flex-1 lg:min-h-0 lg:overflow-hidden">
          <HubWidgets client:load />
        </div>
      </div>

      <!-- COLONNE DROITE : météo + IA / agents -->
      <div class="min-w-0 lg:min-h-0 lg:overflow-hidden flex flex-col gap-3">
        <div class="shrink-0"><WeatherWidget client:load /></div>
        <div class="lg:flex-1 lg:min-h-0"><HubAgents client:load /></div>
      </div>
    </div>
  </div>
  <script is:inline>
    // date du jour côté navigateur (la page est construite à l'avance : sinon la date du build resterait affichée)
    (function () {
      var el = document.querySelector('[data-today]');
      if (el) el.textContent = new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).toUpperCase();
    })();
  </script>
</Base>
